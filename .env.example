# The mock provider works without any endpoint or credentials.
MODEL_PROVIDER=mock
PORT=3000
DATABASE_PATH=./data/router-playground.db

# ---- Foundry (Model Router) — Entra ID auth only ----
# The easiest way to fill in the block below is the built-in setup wizard:
#   .\start.ps1 -Setup
# It creates the Foundry account (with a custom subdomain), grants your account
# the "Cognitive Services User" + "Cognitive Services OpenAI User" roles, deploys
# the three model-router modes, and writes this .env for you.
#
# MODEL_PROVIDER=foundry
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
#
# One deployment per routing mode. Any unset one falls back to
# MODEL_ROUTER_DEPLOYMENT_NAME.
# MODEL_ROUTER_DEPLOYMENT_NAME=mr-balanced
# MODEL_ROUTER_DEPLOYMENT_BALANCED=mr-balanced
# MODEL_ROUTER_DEPLOYMENT_COST=mr-cost
# MODEL_ROUTER_DEPLOYMENT_QUALITY=mr-quality
#
# Surfaces the resource on the Manual / Auto evaluation tabs so anyone watching
# knows which Azure resource is producing the responses.
# AZURE_FOUNDRY_RESOURCE_NAME=YOUR-RESOURCE
# AZURE_FOUNDRY_RESOURCE_GROUP=YOUR-RESOURCE-GROUP
#
# Authentication is Microsoft Entra ID via the Azure CLI:
#   az login
# The adapter calls `az account get-access-token --resource
# https://cognitiveservices.azure.com` on every request. Your signed-in user
# needs the "Cognitive Services User" and "Cognitive Services OpenAI User"
# roles on the resource — the setup wizard grants both automatically.
